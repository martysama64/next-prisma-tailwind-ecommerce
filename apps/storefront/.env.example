# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_prisma_tailwind_ecommerce_storefront?schema=public"

# App
NODE_ENV="development"
NEXT_PUBLIC_URL="http://localhost:7777"
NEXT_PUBLIC_APP_URL="http://localhost:7777"
JWT_SECRET_KEY="replace-with-a-local-development-secret"

# Google OAuth
NEXT_PUBLIC_GOOGLE_OAUTH_ID=""
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URL="http://localhost:7777/login"
GOOGLE_OAUTH_SECRET=""

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Twitter API
TWITTER_API_KEY=""

# Mail
MAIL_SMTP_SERVICE="Gmail"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_SMTP_SECURE="false"
MAIL_SMTP_TLS_REJECT_UNAUTHORIZED="true"
MAIL_SMTP_TLS_CIPHER=""
MAIL_SMTP_VERBOSE="false"

# SMS
SMS_API_KEY=""
SMS_NUMBER=""

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Deployment
VERCEL_URL=""
CRON_SECRET="replace-with-local-cron-secret"
