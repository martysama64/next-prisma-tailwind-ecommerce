# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_prisma_tailwind_ecommerce_admin?schema=public"

# App
NODE_ENV="development"
NEXT_PUBLIC_URL="http://localhost:8888"
JWT_SECRET_KEY="replace-with-a-local-development-secret"

# Google OAuth
NEXT_PUBLIC_GOOGLE_OAUTH_ID=""
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URL="http://localhost:8888/login"
GOOGLE_OAUTH_SECRET=""

# Mail
MAIL_SMTP_SERVICE="Gmail"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_SMTP_SECURE="false"
MAIL_SMTP_TLS_REJECT_UNAUTHORIZED="true"
MAIL_SMTP_TLS_CIPHER=""
MAIL_SMTP_VERBOSE="false"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Deployment
VERCEL_URL=""
